{
  "version": "2.2",
  "status": "design_contract_not_installed_tools",
  "enforcement": "Backend role checks plus native capability restriction; prompts alone do not enforce permissions.",
  "defaults": {
    "secretary": "codex_app_server_independent",
    "receiver": "claude_cli_independent",
    "reviewer": "codex_independent"
  },
  "secretary_allow": ["read_project", "read_task", "read_pr", "read_evidence_index", "read_policy", "read_followups", "send_work_message", "register_intake", "register_followup", "request_approved_assignment", "set_authorized_queue_preference", "present_owner_decision"],
  "secretary_deny": ["shell", "write_business_code", "run_check", "record_review", "record_acceptance", "record_reception", "merge", "approve", "increase_budget", "deploy"],
  "receiver_allow": ["read_project", "read_pr", "read_fixed_candidate", "read_evidence", "send_work_message", "propose_reception_plan", "run_authorized_check", "record_reception", "request_authorized_merge", "reconcile_operation"],
  "author_allow": ["read_task", "read_project", "send_work_message", "propose_coordination", "write_owned_scope", "run_authorized_check", "register_artifact", "submit_pr_handoff"],
  "shared_constraints": ["trusted_actor_from_connection", "adopted_scope_required_for_writes", "unknown_does_not_release_ownership", "no_personal_publish_credentials_in_execution", "candidate_and_plan_bound_results", "no_self_authorization"],
  "runtime_rule": "Effective tools are the intersection of role allowance, registered backend capabilities, current authorization, native version and current session conditions. Never expose an arbitrary URL or shell proxy to the secretary."
}
