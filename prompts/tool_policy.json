  "secretary_allow": ["read_project", "read_task", "read_pr", "read_evidence_index", "read_policy", "read_followups", "read_decision_provenance", "read_outcome_samples", "send_work_message", "register_intake", "register_followup", "request_approved_assignment", "set_authorized_queue_preference", "present_owner_decision", "present_control_request"],
