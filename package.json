{
  "name": "tongxu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/w1/*.test.js dist/tests/w2/*.test.js dist/tests/w3/*.test.js",
    "start": "node dist/src/cli.js",
    "test:docker": "npm run build && node dist/tests/w2/docker-suite.js",
    "test:native": "npm run build && node --test dist/tests/w4/*.test.js",
    "test:relay": "npm run build && node --test dist/tests/w5/*.test.js",
    "test:repair": "npm run build && node --test dist/tests/w5/repair.test.js",
    "test:mac": "npm run build && node --test dist/tests/w1/*.test.js dist/tests/w3/*.test.js dist/tests/w4/codex-results.test.js dist/tests/w5/*.test.js",
    "test:receiver": "npm run build && node --test dist/tests/w3/receiver.test.js",
    "test:publication": "npm run build && node --test dist/tests/w3/publication.test.js",
    "test:secretary": "npm run build && node --test dist/tests/w4/secretary.test.js",
    "test:pair": "npm run build && node --test dist/tests/w6/*.test.js",
    "test:workbench": "npm run build && node --test dist/tests/w7/*.test.js",
    "workbench": "node dist/src/workbench-cli.js",
    "test:project-repair": "npm run build && node --test dist/tests/project-repair/*.test.js"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
